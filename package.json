{
  "name": "chachi-agrivet-pos",
  "productName": "Chachi Agrivet POS",
  "version": "1.0.0",
  "description": "Local-first point of sale and inventory for a Philippine agrivet store",
  "author": "Chachi's Software Development Service",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node src/server.js",
    "start:electron": "electron .",
    "migrate": "node src/config/migrate.js",
    "test:unit": "node src/tests/run.js unit",
    "test": "node src/tests/run.js unit integration",
    "test:e2e": "node src/tests/run.js e2e",
    "test:perf": "node src/tests/run.js perf",
    "test:all": "node src/tests/run.js unit integration e2e",
    "build:exe": "electron-builder --win --publish never"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "store.chachisoftware.agrivetpos",
    "productName": "ChachiAgrivetPOS",
    "artifactName": "ChachiAgrivetPOS-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "src/**/*",
      "public/**/*",
      "package.json",
      "!src/tests/**/*",
      "!**/*.md"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico",
      "publish": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chachi Agrivet POS",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Chachi Agrivet POS",
      "runAfterFinish": true
    },
    "extraMetadata": {
      "version": "1.0.0"
    }
  }
}
