<?xml version="1.0" encoding="utf-8"?>
<!-- Chachi POS for Android — TASK-049. See android/README.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The WebView talks to the server on 127.0.0.1, and a LAN receipt printer is raw
         TCP on port 9100 (INT-1). Nothing here reaches the internet (NFR_3.1). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- OPS-001: backups outside the app's own storage, in Documents/ChachiPOS Backups. On
         Android 11+ an app writes its own files there with no permission; Android 8–10 needs
         the ordinary storage permission. No "all files access": Google Play does not permit it
         for a point of sale, and the app only ever touches its own backups. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- TASK-069: barcodes read with the camera. Google's code scanner needs no permission; this
         is for the web reader, used only on a phone without Play services, and asked for at
         runtime the first time it is used. Not required, so a device without a camera still
         installs the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- TASK-052: the camera app, asked for a product's photo. Declared so Android 11+
         lets this app see that one exists; the CAMERA permission is not needed, because
         the photo is taken by the camera app, not by this one. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- allowBackup is off: the store's customers and their balances do not go to a cloud
         backup nobody chose (SEC-10). The store's own backups are OPS-001's. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Pos"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TASK-069: Play services fetches the code scanner when the app is installed, so it
             works offline from the first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Where the camera writes a product's photo (TASK-052). Not exported: reached
             only through the one-time grant on the camera intent. -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
